# 데이터베이스 (Vercel에서 Neon Postgres를 연결하면 자동으로 들어옵니다)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/muscat

# 관리자 로그인 암호화용 비밀값 (아무 긴 무작위 문자열)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# 사이트 주소 (배포 후 실제 도메인으로)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# 이미지 저장소 (Vercel에서 Blob을 연결하면 자동으로 들어옵니다. 로컬에서는 비워 둠)
BLOB_READ_WRITE_TOKEN=
